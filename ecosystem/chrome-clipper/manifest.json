{
  "manifest_version": 3,
  "name": "HaoRan · 转载到我的网站",
  "version": "1.1.0",
  "description": "从已打开的公众号文章自动提取标题、正文和图片，保存到个人网站并继续编辑。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mmbiz.qpic.cn/*",
    "https://mmbiz.qlogo.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
